XIAOAI_USERNAME=your_xiaomi_id_or_phone
XIAOAI_PASSWORD=your_xiaomi_password

# Optional: speaker name in Mi Home. If omitted, the first online speaker is used.
XIAOAI_DEVICE_NAME=卧室小爱

# Optional: persisted Xiaomi session path.
XIAOAI_SESSION_PATH=.data/xiaoai-session.json

# Optional: fixed volume before speaking.
# XIAOAI_VOLUME=35

# Codex notify wording.
CODEX_DONE_TEXT=AI 编程任务已完成，请查看结果。
CODEX_ASK_TEXT=AI 需要你确认，请看一下屏幕。
CODEX_OUTPUT_DONE_TEXT=AI 编程任务已完成，请查看结果。
CODEX_SPEAK_FINAL_TEXT=true
CODEX_SPEAK_FINAL_MAX_CHARS=60
CODEX_OUTPUT_POLL_MS=2000

# Optional: keep the existing Codex desktop notification command.
# CODEX_NOTIFY_PASSTHROUGH=/path/to/SkyComputerUseClient
# CODEX_NOTIFY_PASSTHROUGH_ARG=turn-ended

# Voice reply webhook.
VOICE_REPLY_PORT=3337

# clipboard: only copy reply text to clipboard.
# paste: activate target app and paste reply text.
# submit: activate target app, paste reply text, and press Enter.
VOICE_REPLY_MODE=clipboard
VOICE_REPLY_TARGET_APP=Codex
VOICE_REPLY_SUBMIT_DELAY_MS=300
# Optional: use a signed helper app for macOS Accessibility instead of osascript.
# VOICE_REPLY_TYPER_APP=/Users/you/Desktop/小爱Codex输入助手.app

# Pair nearby XiaoAi records when long voice replies are split into "回复" and content.
XIAOAI_REPLY_PAIR_WINDOW_MS=180000
# In Codex reply mode, collect multiple recognized segments before sending.
XIAOAI_REPLY_COLLECT_IDLE_MS=12000

# MiGPT voice listener.
# MiGPT usually wants Xiaomi ID, not phone number. If phone login fails, fill this.
# MIGPT_XIAOMI_USER_ID=123456789
MIGPT_DID=卧室小爱
MIGPT_REPLY_PREFIX=回复
MIGPT_REPLY_WEBHOOK=http://127.0.0.1:3337/reply

# Lightweight XiaoAi conversation listener, preferred when MiGPT asks for passToken.
XIAOAI_REPLY_PREFIX=回复
XIAOAI_REPLY_WEBHOOK=http://127.0.0.1:3337/reply
XIAOAI_LISTENER_POLL_MS=1500
